{
  "expo": {
    "name": "Student Pro",
    "slug": "student-pro",
    "icon": "./assets/images/logo.png",
    "splash": {
      "backgroundColor": "#059669"
    },
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "package": "com.superhtun.studentpro"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "ပြေစာများကို သိမ်းဆည်းရန် ဓာတ်ပုံအသုံးပြုခွင့် လိုအပ်ပါသည်။",
          "savePhotosPermission": "ပြေစာများကို သိမ်းဆည်းရန် ဓာတ်ပုံအသုံးပြုခွင့် လိုအပ်ပါသည်။"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "45396cc0-c80d-4c80-a40b-395b6dabcacd"
      }
    }
  }
}